<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>mx.edu.uaz.ingsoft.poo2</groupId>
  <artifactId>siscap</artifactId>
  <version>1.0-SNAPSHOT</version>

  <name>siscap</name>
  <!-- FIXME change it to the project's website -->
  <url>http://www.example.com</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      Objetivo de compilación: Java 21 LTS.
      maven.compiler.release fuerza a javac a compilar con la opción "release 21":
      el bytecode generado es de Java 21 y solo se permiten las API del JDK 21.
      Esto funciona aunque el JDK instalado sea más nuevo (p. ej. 25); NO es
      necesario (ni recomendado) tener el JDK 21 instalado para compilar.
    -->
    <maven.compiler.release>21</maven.compiler.release>
    <!-- Implementación de referencia de JPA (Jakarta Persistence 3.1 / Jakarta EE 10) -->
    <eclipselink.version>4.0.9</eclipselink.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>5.11.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.50.3.0</version>
    </dependency>
    <!-- EclipseLink: JPA (referencia). Incluye jakarta.persistence-api como dependencia transitiva -->
    <dependency>
      <groupId>org.eclipse.persistence</groupId>
      <artifactId>org.eclipse.persistence.jpa</artifactId>
      <version>${eclipselink.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Optionally: parameterized tests support -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Motor de JUnit 5: sin él, Surefire compila las pruebas pero NO las ejecuta -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- SLFG -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.9</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.9</version>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement><!-- lock down plugins versions to avoid using Maven defaults (may be moved to parent pom) -->
      <plugins>
        <!-- clean lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#clean_Lifecycle -->
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <!-- default lifecycle, jar packaging: see https://maven.apache.org/ref/current/maven-core/default-bindings.html#Plugin_bindings_for_jar_packaging -->
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.3.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <!-- site lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#site_Lifecycle -->
        <plugin>
          <artifactId>maven-site-plugin</artifactId>
          <version>3.12.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-project-info-reports-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!--
        Ejecución de los programas del proyecto SIEMPRE vía Maven, con nombres
        cortos. El classpath (incluido el driver de SQLite) lo resuelve Maven;
        nunca armar el classpath a mano ni buscar jars en el repositorio local.
        Uso:  mvn compile exec:java@<id>
        Ejemplo: mvn compile exec:java@catalogos-graficos
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>ingesta-inicial</id>
            <configuration>
              <mainClass>mx.edu.uaz.ingsoft.poo2.utils.inicio_bd.IngestaInicial</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>catalogos-graficos</id>
            <configuration>
              <mainClass>mx.edu.uaz.ingsoft.poo2.programas.catalogos.GestionGraficaCatalogos</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>catalogo-unico</id>
            <configuration>
              <mainClass>mx.edu.uaz.ingsoft.poo2.programas.catalogos.GestionCatalogoUnico</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>ingesta-capacitaciones</id>
            <configuration>
              <mainClass>mx.edu.uaz.ingsoft.poo2.utils.inicio_bd.IngestaCapacitaciones</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>tutor-relaciones</id>
            <configuration>
              <mainClass>mx.edu.uaz.ingsoft.poo2.programas.capacitaciones.TutorRelaciones</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>capacitaciones</id>
            <configuration>
              <mainClass>mx.edu.uaz.ingsoft.poo2.programas.capacitaciones.GestionCapacitaciones</mainClass>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
